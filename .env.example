# Public HTTPS origin exposed to Twilio, without a trailing slash.
VOICEBOT_PUBLIC_BASE_URL=https://your-tunnel.example
VOICEBOT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOICEBOT_TWILIO_AUTH_TOKEN=replace-me
VOICEBOT_TWILIO_FROM_NUMBER=+15555550100
# Required for live calls; use a long random value.
VOICEBOT_MEDIA_STREAM_TOKEN=replace-with-a-random-secret
VOICEBOT_VALIDATE_TWILIO_SIGNATURES=true
VOICEBOT_OPENAI_API_KEY=replace-me
VOICEBOT_OPENAI_REALTIME_MODEL=gpt-realtime
VOICEBOT_OPENAI_VOICE=marin
VOICEBOT_DEFAULT_SCENARIO=appointment-scheduling
VOICEBOT_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
VOICEBOT_OPENAI_EVALUATION_MODEL=gpt-5-mini
VOICEBOT_CALLS_DIRECTORY=calls
VOICEBOT_RECORDING_DOWNLOAD_ATTEMPTS=4
VOICEBOT_RECORDING_RETRY_SECONDS=2
VOICEBOT_SUITE_POLL_SECONDS=2
VOICEBOT_REPORT_CONFIDENCE_THRESHOLD=0.8
VOICEBOT_CALL_TIMEOUT_SECONDS=300
VOICEBOT_LOG_LEVEL=INFO
