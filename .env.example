# Public HTTPS origin exposed to Twilio, without a trailing slash.
VOICEBOT_PUBLIC_BASE_URL=https://your-tunnel.example
VOICEBOT_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOICEBOT_TWILIO_AUTH_TOKEN=replace-me
VOICEBOT_TWILIO_FROM_NUMBER=+15555550100
# Required for live calls; use a long random value.
VOICEBOT_MEDIA_STREAM_TOKEN=replace-with-a-random-secret
VOICEBOT_CALL_TIMEOUT_SECONDS=300
VOICEBOT_LOG_LEVEL=INFO
